<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: two-column status card + compact inline bottom controls -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.SEUDoorLock.ToolbarTitle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:paddingEnd="12dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/refresh"
                    android:padding="12dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/on_surface_variant"/>

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_title"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/on_surface_variant"/>
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/main_scroll_padding_h"
        android:paddingEnd="@dimen/main_scroll_padding_h"
        android:paddingTop="@dimen/main_scroll_padding_v"
        android:paddingBottom="@dimen/main_scroll_padding_v">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_max="@dimen/main_card_max_width"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintVertical_bias="0.5"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant"
                app:cardBackgroundColor="@color/surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Left column: status icon + title -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/statusIconContainer"
                            android:layout_width="@dimen/status_icon_size"
                            android:layout_height="@dimen/status_icon_size"
                            android:layout_marginTop="@dimen/status_icon_margin_top"
                            android:background="@drawable/bg_status_icon">

                            <ImageView
                                android:id="@+id/ivStatusIcon"
                                android:layout_width="@dimen/status_icon_glyph"
                                android:layout_height="@dimen/status_icon_glyph"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock_outline"
                                app:tint="@color/primary"/>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvStatusTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/status_title_margin_top"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:gravity="center"
                            android:textColor="@color/on_surface"
                            tools:text="Hold near the door lock"/>
                    </LinearLayout>

                    <!-- Right column: detail + contextual actions -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:layout_marginStart="@dimen/element_spacing"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvStatusDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_detail"
                                android:fontFamily="monospace"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/status_detail_min_height"
                                android:padding="16dp"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                tools:text="Phone: 138****1234\nLock: Building A\nBattery: 85%"/>

                            <ImageButton
                                android:id="@+id/btnInfo"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/info_button"
                                android:padding="6dp"
                                android:src="@drawable/ic_info"
                                app:tint="@color/on_surface_variant"/>
                        </FrameLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnableNfc"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/main_button_height"
                            android:layout_marginTop="@dimen/button_spacing"
                            android:text="@string/enable_nfc_button"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/ic_nfc"
                            android:visibility="gone"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGrantPermissions"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/main_button_height"
                            android:layout_marginTop="@dimen/button_spacing"
                            android:text="@string/grant_permissions"
                            app:cornerRadius="28dp"
                            android:visibility="gone"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBleUnlock"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/main_button_height"
                            android:layout_marginTop="@dimen/button_spacing"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/ble_connect_button"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/ic_bluetooth"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Controls: toggle + logout on one row, width capped on larger screens -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="@dimen/main_controls_max_width"
            app:layout_constraintHorizontal_bias="0.5">

            <!-- Segmented Toggle Group -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnTabNfc">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabNfc"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/main_button_height"
                    android:layout_weight="1"
                    android:text="@string/settings_method_nfc"
                    app:icon="@drawable/ic_nfc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabBle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/main_button_height"
                    android:layout_weight="1"
                    android:text="@string/settings_method_ble"
                    app:icon="@drawable/ic_bluetooth" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="@dimen/main_button_height"
                android:text="@string/main_logout"
                android:textColor="@color/error"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/error"
                app:iconGravity="textStart"
                app:iconPadding="12dp"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
